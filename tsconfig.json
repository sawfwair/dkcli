{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@dkcli/core": ["packages/core/src/index.ts"],
      "@dkcli/core/*": ["packages/core/src/*"],
      "@dkcli/tokens": ["packages/tokens/src/index.ts"],
      "@dkcli/tokens/*": ["packages/tokens/src/*"],
      "@dkcli/components": ["packages/components/src/index.ts"],
      "@dkcli/components/*": ["packages/components/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "*.ts",
    "examples/svelte-starter/**/*.ts",
    "packages/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "packages/*/dist",
    "packages/components/.dk-cli-cache"
  ]
}
