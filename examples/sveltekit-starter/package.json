{
  "name": "designkit-release-desk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test src/lib/model.test.js",
    "check:server": "node scripts/check-server.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@dkcli/components": "0.0.0-local",
    "@dkcli/core": "0.0.0-local",
    "@dkcli/tokens": "0.0.0-local",
    "svelte": "5.55.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.58.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "^22",
    "svelte-check": "4.3.4",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
